    "/api/v1/autonomous/jobs": {
      "post": {
        "operationId": "postAutonomousJobs",
        "summary": "Submit an autonomous job",
        "description": "Queues a multi-step autonomous goal. Returns 202 with a job id immediately — a cloud worker plans, resolves credentials (presence/last4 only), runs tools, recovers, verifies, then completes. Poll GET /api/v1/autonomous/jobs/{id}. Separate product from wrap jobs at /api/v1/jobs.",
        "tags": [
          "autonomous"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "goal": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 8000
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "maxItems": 40
                  },
                  "providers": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "maxItems": 20
                  },
                  "injectFailure": {
                    "type": "boolean"
                  },
                  "webhookUrl": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "goal"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The queued autonomous job.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiSuccess"
                }
              }
            }
          },
          "400": {
