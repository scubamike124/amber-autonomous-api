{
  "openapi": "3.1.0",
  "info": {
    "title": "Amber Autonomous API",
    "version": "1.0.0",
    "summary": "Submit a multi-step goal. Amber works in the cloud and returns a verified result.",
    "description": "Amber Autonomous API is a separate product from the AmberOne Wrap API.\n\nPOST /api/v1/autonomous/jobs → job ID (202). Cloud worker plans, runs, recovers, verifies.\nWrap packaging is /api/v1/jobs — different capability and quotas.",
    "license": {
      "name": "Commercial",
      "url": "https://amberoneai.com/terms"
    },
    "termsOfService": "https://amberoneai.com/terms",
    "contact": {
      "name": "AmberOne API support",
      "url": "https://amberoneai.com/privacy"
    }
  },
  "servers": [
    {
      "url": "https://hq.amberoneai.com",
      "description": "Production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "account",
      "description": "Key, plan and usage."
    },
    {
      "name": "usage",
      "description": "Metered consumption."
    },
    {
      "name": "autonomous",
      "description": "Autonomous jobs."
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Send your API key as `Authorization: Bearer wrap_live_…`. `X-API-Key: <key>` is also accepted. Keys beginning `wrap_test_` run the full pipeline and are never billed."
      }
    },
    "schemas": {
      "ApiSuccess": {
        "type": "object",
        "required": [
          "ok",
          "data",
          "requestId"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "description": "Endpoint-specific payload."
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "ok",
          "error",
          "requestId"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_request",
                  "url_rejected",
                  "unsupported_platform",
                  "missing_api_key",
                  "invalid_api_key",
                  "api_key_revoked",
                  "api_key_expired",
                  "forbidden",
                  "plan_required",
                  "not_found",
                  "job_not_cancellable",
                  "conflict",
                  "payload_too_large",
                  "quota_exceeded",
                  "rate_limited",
                  "internal_error",
                  "not_implemented",
                  "upstream_unavailable"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "description": "Validation detail, when applicable."
              }
            }
          },
          "requestId": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/account": {
      "get": {
        "operationId": "getAccount",
        "summary": "Account, plan and usage",
        "description": "Returns the account the key belongs to, the plan's limits, and usage for the current billing period. Call this first to confirm a key works — it consumes no wrap quota.",
        "tags": [
          "account"
        ],
        "responses": {
          "200": {
            "description": "Account, key, plan and usage.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiSuccess"
                }
              }
            }
          },
          "401": {
            "description": "`missing_api_key`, `invalid_api_key`, `api_key_revoked`, `api_key_expired`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "examples": {
                  "missing_api_key": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "missing_api_key",
                        "message": "No API key was supplied. Send Authorization: Bearer <key>."
                      },
                      "requestId": "req_0f3c1a9b2e4d"
                    }
                  },
                  "invalid_api_key": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "invalid_api_key",
                        "message": "The API key is not recognised."
                      },
                      "requestId": "req_0f3c1a9b2e4d"
                    }
                  },
                  "api_key_revoked": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "api_key_revoked",
                        "message": "This API key has been revoked."
                      },
                      "requestId": "req_0f3c1a9b2e4d"
                    }
                  },
                  "api_key_expired": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "api_key_expired",
                        "message": "This API key has expired."
                      },
                      "requestId": "req_0f3c1a9b2e4d"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "`rate_limited`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "examples": {
                  "rate_limited": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "rate_limited",
                        "message": "Too many requests. Retry after the interval in Retry-After."
                      },
                      "requestId": "req_0f3c1a9b2e4d"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "`internal_error`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "examples": {
                  "internal_error": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "internal_error",
                        "message": "Something failed on our side. The requestId identifies this occurrence."
                      },
                      "requestId": "req_0f3c1a9b2e4d"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
